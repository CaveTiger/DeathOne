<!-- Type: 스탯만 올리면 None+TargetStat. 그 외는 enum 이름(ManaBoost, TurnIntervalGrantStatus 등) 또는 CustomScript+ScriptClass. PassiveSystemExtensionGuide.cs 참고 -->
<Passives>
