        <Name>기본 패시브</Name>
        <Description>기본 패시브입니다.</Description>
        <Type>None</Type>
        <TargetStat>None</TargetStat> <!-- 단순 스탯증가류 패시브의 경우 -->
        <Value>0</Value>
        <FloatValue>0.0</FloatValue>
        <GrantsMana>False</GrantsMana>
        <MaxMana>0</MaxMana>
        <ManaRegenInterval>0</ManaRegenInterval>
        <Rarity>Normal</Rarity>
        <Cost>0</Cost>
        <ScriptClass>none</ScriptClass>
    </Passive>
    
